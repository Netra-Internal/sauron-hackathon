# /etc/netra-nodeguard.env on the droplet (root 0600, never in git). Real values live only on the machine.
DISCORD_WEBHOOK_URL=<webhook>
DISCORD_MENTION_USER_ID=<user id>
NODEGUARD_TOKEN=<random, also in the Pi's /etc/netra-node-report.env>
BIND=<droplet-tailscale-ip>:8790
NODE=demo-node
CAMERA=demo-linovision
# approved night off, local time (days = the mornings); empty = always alert. No inline comments: systemd reads this file.
SCHEDULE_OFF="Mon-Fri 01:00-06:00 America/Los_Angeles"
#NODE_TS_HOST=demo-node
#STATE_DIR=/var/lib/netra-nodeguard
