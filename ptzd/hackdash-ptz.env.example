# Env read by hackdash (sauron-hack.service on the droplet) for launch.py and ptz.py. All have working defaults.
# launch.py
ASK_URL=http://127.0.0.1:8400/ask
ASK_WORKER_TOKEN=<netra-ask worker token>
ASK_DATABASE_URL=postgresql:///netra_ask
DROPLINK_URL=http://127.0.0.1:8510
# ptz.py
PTZ_CAMS=axis-q6215=http://127.0.0.1:8530
PTZ_SNAP_CAMS=axis-q6215=http://127.0.0.1:8531
PTZD_TOKEN_FILE=/etc/ptzd-token          # or PTZD_TOKEN=<token>
PTZ_OPERATORS=william                    # only these sign-ins may move the camera
PTZ_NEVER=hack_launch                    # never allowed, even if listed above
PTZ_LOCK_FILE=/var/lib/sauron-hack/ptz-lock.json
