# /etc/ptzd.env on the box next to the camera (root:root 600). install.sh writes it from ~/.config/netra/axis-q6215.env
# plus the token it creates on the droplet in /etc/ptzd-token.
PTZ_CAM_HOST=192.168.0.90
PTZ_CAM_USER=<axis user>
PTZ_CAM_PASS=<axis password>
PTZD_TOKEN=<contents of droplet /etc/ptzd-token>
# optional
# PTZD_LISTEN=127.0.0.1:8530
# PTZD_DEADMAN_S=1.2
# PTZD_PRESETS=hack-home
