# Env read by hackdash.live and hackdash.relay (template, no secrets). On the droplet these come from
# /etc/netra-ask.env (read first by sauron-hack.service) plus /etc/sauron-hack.env overrides.
ASK_WORKER_TOKEN=<netra-ask worker token: same value as ASK_WORKER_TOKEN in /etc/netra-ask.env>
ASK_EDGE_URL=http://127.0.0.1:8450                 # Jetson edge-serve through netra-ask-edge-tunnel
ASK_DATABASE_URL=postgresql:///netra_ask           # read-only use; peer auth, so the unit runs as user netra
# optional (defaults shown)
#ASK_SITES_YAML=/opt/netra/netra-ask/ask/sites.yaml
#HACK_TEST_RIGS=jetson-c920
#HACK_JUDGE_SSH=jetson-cloud=netra@<jetson-tailnet-ip>  # sites.yaml node_id=ssh target, for `systemctl is-active netra-dispatch@<cam>`
#HACK_KNOWN_HOSTS=/tmp/sauron-hack-known_hosts
#HACK_BOX_KINDS=person                              # edge track kinds drawn (person,car only for testing alignment)
#HACK_RELAY_ASK_URL=http://127.0.0.1:8400/ask       # netra-ask direct, not through nginx (no mirror loop)
#HACK_RELAY_DIR=/var/lib/sauron-hack/relay
#HACK_RELAY_MAX_MB=2000                             # spool above this -> 503 (the edge keeps the bucket and retries)
