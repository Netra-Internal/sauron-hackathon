# /etc/sauron-hack.env (root:netra 0640), read by sauron-hack.service AFTER /etc/netra-ask.env.
# TEMPLATE ONLY: placeholders, no real values. On the droplet the ASK_* values come from netra-ask's own
# /etc/netra-ask.env; this file holds only sauron-hack overrides (today it is just its header comment).
#
# Netra-internal login (common.auth) and netra-ask
#ASK_INTERNAL_DIR=/opt/netra/netra-internal
#ASK_URL=http://127.0.0.1:<ask-port>
#ASK_DATABASE_URL=postgresql:///netra_ask
#ASK_EDGE_URL=http://127.0.0.1:8450
#ASK_WORKER_TOKEN=<worker-bearer-token>
#
# Jetson judge check: sites.yaml node_id=ssh target (unset = judge state "unknown"); install.sh also reads the host from here
#HACK_JUDGE_SSH=jetson-cloud=netra@<jetson-tailnet-ip>
#HACK_KNOWN_HOSTS=/var/lib/sauron-hack/known_hosts
#
# PTZ (hackdash.ptz) — never point tests at the real camera
#PTZD_TOKEN=<ptzd-token>
#
# Local dev only: turn the login off. NEVER on the droplet.
#HACK_NO_AUTH=1
