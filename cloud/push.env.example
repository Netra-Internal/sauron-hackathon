# Box-side env for cloud/push.sh (Jetson: ~/cloud/push.env, mode 600). Placeholders: never commit the real values.
STREAMS="axis-q6215=rtsp://USER:PASS@<camera-ip>/axis-media/media.amp?videocodec=h264&resolution=1280x720&fps=5&videokeyframeinterval=5"
POD=<pod>:<pod's public port for 8322; changes on every pod restart>
PUSH_PASS=<mediamtx pusher password, ~/.config/netra/cloud-edge.env>
RELAY=cloudrelay@<droplet>
WIFI_IF=wlP1p1s0
EDGE_FFMPEG=/opt/ffmpeg/ffmpeg
